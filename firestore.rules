rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function invitationPath(inviteHash) {
      return /databases/$(database)/documents/invitations/$(inviteHash);
    }

    function workspaceTodoPath(workspaceId, recordId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/todos/$(recordId);
    }

    function todoPurgeMarkerPath(workspaceId, recordId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/todoPurgeMarkers/$(recordId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function validTodoRecord(record, recordId) {
      return record is map
        && record.keys().hasAll(['id', 'title', 'category', 'done', 'by'])
        && record.keys().hasOnly(['id', 'title', 'category', 'dueDate', 'memo', 'url', 'address', 'done', 'by'])
        && record.id == recordId
        && record.title is string
        && record.title.size() > 0
        && record.title.size() <= 2000
        && record.category is string
        && record.category.size() > 0
        && record.category.size() <= 80
        && record.done is bool
        && record.by in ['A', 'B']
        && (!('dueDate' in record) || (record.dueDate is string && record.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('memo' in record) || (record.memo is string && record.memo.size() <= 10000))
        && (!('url' in record) || (record.url is string && record.url.size() <= 2000))
        && (!('address' in record) || (record.address is string && record.address.size() <= 2000));
    }

    function validTodoCategory(record, recordId) {
      return record is map
        && record.keys().hasAll(['id', 'name', 'tone'])
        && record.keys().hasOnly(['id', 'name', 'tone'])
        && record.id == recordId
        && record.name is string
        && record.name.size() > 0
        && record.name.size() <= 80
        && record.tone in ['peach', 'green', 'lavender', 'blue', 'mint', 'yellow', 'rose', 'neutral', 'life', 'outing', 'couple'];
    }

    function validCalendarEvent(record, recordId) {
      return record is map
        && record.keys().hasAll(['id', 'title', 'date', 'category', 'by'])
        && record.keys().hasOnly(['id', 'title', 'date', 'time', 'endTime', 'address', 'memo', 'category', 'by'])
        && record.id == recordId
        && record.title is string
        && record.title.size() > 0
        && record.title.size() <= 2000
        && record.date is string
        && record.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && record.category in ['暮らし', 'おでかけ', 'ふたり', 'その他']
        && record.by in ['A', 'B', 'both']
        && (!('time' in record) || (record.time is string && record.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('endTime' in record) || (record.endTime is string && record.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('address' in record) || (record.address is string && record.address.size() <= 2000))
        && (!('memo' in record) || (record.memo is string && record.memo.size() <= 10000));
    }

    function validWorkspaceRecordPayload(data, collectionName, recordId) {
      return data is map
        && data.keys().hasAll(['record', 'revision', 'deleted', 'sortOrder', 'createdAt', 'updatedAt', 'updatedByUid'])
        && data.keys().hasOnly(['record', 'revision', 'deleted', 'sortOrder', 'createdAt', 'updatedAt', 'updatedByUid', 'lastMutationId', 'sourceInstallId', 'sourceRecordId'])
        && data.revision is int
        && data.revision > 0
        && data.revision <= 2147483647
        && data.deleted is bool
        && data.sortOrder is number
        && data.sortOrder >= 0
        && data.sortOrder <= 10000000000000
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid
        && (collectionName == 'todos' ? validTodoRecord(data.record, recordId)
          : collectionName == 'todoCategories' ? validTodoCategory(data.record, recordId)
            : collectionName == 'calendarEvents' && validCalendarEvent(data.record, recordId))
        && (!('sourceInstallId' in data) || (data.sourceInstallId is string && data.sourceInstallId.size() <= 128))
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 256))
        && (!('lastMutationId' in data) || (data.lastMutationId is string && data.lastMutationId.size() <= 128));
    }

    function validWorkspaceRecordCreate(data, collectionName, recordId) {
      return validWorkspaceRecordPayload(data, collectionName, recordId)
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validWorkspaceRecordUpdate(data, collectionName, recordId) {
      return validWorkspaceRecordPayload(data, collectionName, recordId)
        && resource.data.revision is int
        && data.revision == resource.data.revision + 1
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }

    function validTodoPurgeMarker(data) {
      return data is map
        && data.keys().hasAll(['revision', 'updatedAt', 'updatedByUid', 'lastMutationId'])
        && data.keys().hasOnly(['revision', 'updatedAt', 'updatedByUid', 'lastMutationId'])
        && data.revision is int
        && data.revision > 0
        && data.revision <= 2147483647
        && data.updatedAt == request.time
        && data.updatedByUid == request.auth.uid
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128;
    }

    function validTodoPurgeMarkerCreate(data, workspaceId, recordId) {
      return validTodoPurgeMarker(data)
        && (
          (!exists(workspaceTodoPath(workspaceId, recordId)) && data.revision == 1)
          ||
          (
            exists(workspaceTodoPath(workspaceId, recordId))
            && get(workspaceTodoPath(workspaceId, recordId)).data.deleted == false
            && get(workspaceTodoPath(workspaceId, recordId)).data.record.done == true
            && data.revision == get(workspaceTodoPath(workspaceId, recordId)).data.revision + 1
          )
        );
    }

    function validTodoPurgeMarkerUpdate(data, workspaceId, recordId) {
      return validTodoPurgeMarker(data)
        && resource.data.revision is int
        && (
          (
            !exists(workspaceTodoPath(workspaceId, recordId))
            && data.revision == resource.data.revision + 1
          )
          ||
          (
            get(workspaceTodoPath(workspaceId, recordId)).data.deleted == false
            && get(workspaceTodoPath(workspaceId, recordId)).data.record.done == true
            && data.revision == get(workspaceTodoPath(workspaceId, recordId)).data.revision + 1
            && data.revision > resource.data.revision
          )
        );
    }

    function validWorkspaceTodoRestore(data, workspaceId, recordId) {
      let marker = get(todoPurgeMarkerPath(workspaceId, recordId)).data;
      return validWorkspaceRecordPayload(data, 'todos', recordId)
        && data.revision == marker.revision + 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validTodoPurgeDelete(workspaceId, recordId) {
      let marker = getAfter(todoPurgeMarkerPath(workspaceId, recordId)).data;
      return isWorkspaceMember(workspaceId)
        && resource.data.deleted == false
        && resource.data.record.done == true
        && marker.revision == resource.data.revision + 1
        && marker.updatedByUid == request.auth.uid;
    }

    function validConflictSide(kind, action, record, entityId) {
      return action == 'purge'
        ? (kind == 'todos' && record == null)
        : action == 'delete'
        ? (record == null || (kind == 'todos' ? validTodoRecord(record, entityId)
          : kind == 'categories' ? validTodoCategory(record, entityId)
            : kind == 'events' && validCalendarEvent(record, entityId)))
        : action == 'upsert' && (kind == 'todos' ? validTodoRecord(record, entityId)
          : kind == 'categories' ? validTodoCategory(record, entityId)
            : kind == 'events' && validCalendarEvent(record, entityId));
    }

    function validConflictCreate(data) {
      return data is map
        && data.keys().hasAll(['kind', 'entityId', 'entityName', 'localAction', 'localRecord', 'remoteAction', 'remoteRecord', 'localSortOrder', 'remoteSortOrder', 'baseRevision', 'remoteRevision', 'createdByUid', 'createdAt', 'status'])
        && data.keys().hasOnly(['kind', 'entityId', 'entityName', 'localAction', 'localRecord', 'remoteAction', 'remoteRecord', 'localSortOrder', 'remoteSortOrder', 'baseRevision', 'remoteRevision', 'createdByUid', 'createdAt', 'status'])
        && data.kind in ['todos', 'categories', 'events']
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityName is string
        && data.entityName.size() <= 2000
        && validConflictSide(data.kind, data.localAction, data.localRecord, data.entityId)
        && validConflictSide(data.kind, data.remoteAction, data.remoteRecord, data.entityId)
        && (data.localSortOrder == null || (data.localSortOrder is number && data.localSortOrder >= 0))
        && (data.remoteSortOrder == null || (data.remoteSortOrder is number && data.remoteSortOrder >= 0))
        && data.baseRevision is int
        && data.baseRevision >= 0
        && data.remoteRevision is int
        && data.remoteRevision >= 0
        && data.createdByUid == request.auth.uid
        && data.createdAt == request.time
        && data.status == 'unresolved';
    }

    function validConflictUpdate(data) {
      return resource.data.status == 'unresolved'
        && data.status == 'unresolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entityName', 'remoteAction', 'remoteRecord', 'remoteSortOrder', 'remoteRevision', 'refreshedAt'])
        && data.entityName is string
        && data.entityName.size() <= 2000
        && validConflictSide(data.kind, data.remoteAction, data.remoteRecord, data.entityId)
        && (data.remoteSortOrder == null || (data.remoteSortOrder is number && data.remoteSortOrder >= 0))
        && data.remoteRevision is int
        && data.remoteRevision >= resource.data.remoteRevision
        && data.refreshedAt == request.time;
    }

    function validConflictLocalRefresh(data) {
      return resource.data.status == 'unresolved'
        && resource.data.createdByUid == request.auth.uid
        && data.status == 'unresolved'
        && data.localUpdatedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entityName', 'localAction', 'localRecord', 'localSortOrder', 'localUpdatedByUid'])
        && data.entityName is string
        && data.entityName.size() <= 2000
        && validConflictSide(data.kind, data.localAction, data.localRecord, data.entityId)
        && (data.localSortOrder == null || (data.localSortOrder is number && data.localSortOrder >= 0));
    }

    function validConflictResolution(data) {
      return resource.data.status == 'unresolved'
        && data.status == 'resolved'
        && data.resolution in ['local', 'remote']
        && data.resolvedByUid == request.auth.uid
        && data.resolvedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolvedByUid', 'resolvedAt']);
    }

    function validSyncDeviceCreate(installId, data) {
      return data is map
        && data.keys().hasAll(['uid', 'installId', 'importedLocalData', 'activatedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'installId', 'importedLocalData', 'activatedAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.installId == installId
        && data.importedLocalData is bool
        && data.activatedAt == request.time
        && data.updatedAt == request.time;
    }

    function validSyncDeviceUpdate(installId, data) {
      return resource.data.uid == request.auth.uid
        && data is map
        && data.keys().hasAll(['uid', 'installId', 'importedLocalData', 'activatedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'installId', 'importedLocalData', 'activatedAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.installId == installId
        && data.importedLocalData is bool
        && (resource.data.importedLocalData == true ? data.importedLocalData == true : true)
        && data.activatedAt == resource.data.activatedAt
        && data.updatedAt == request.time;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && exists(memberPath(workspaceId, request.auth.uid));
    }

    function hasOpenInvite(workspaceId) {
      let inviteHash = resource.data.activeInviteHash;
      return inviteHash is string
        && exists(invitationPath(inviteHash))
        && get(invitationPath(inviteHash)).data.workspaceId == workspaceId
        && get(invitationPath(inviteHash)).data.status == 'pending'
        && get(invitationPath(inviteHash)).data.expiresAt > request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if false;

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['workspaceId', 'createdAt'])
        && request.resource.data.workspaceId is string
        && request.resource.data.createdAt == request.time
        && getAfter(workspacePath(request.resource.data.workspaceId)).data.memberUids.hasAny([uid])
        && existsAfter(memberPath(request.resource.data.workspaceId, uid));

      allow update, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get: if isWorkspaceMember(workspaceId) || (signedIn() && hasOpenInvite(workspaceId));
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'memberUids', 'activeInviteHash', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.activeInviteHash == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.slot == 'A'
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.role == 'owner'
        && getAfter(userPath(request.auth.uid)).data.workspaceId == workspaceId;

      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.memberUids == [request.auth.uid]
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeInviteHash', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.activeInviteHash is string
          && request.resource.data.activeInviteHash.matches('^[a-f0-9]{64}$')
          && getAfter(invitationPath(request.resource.data.activeInviteHash)).data.workspaceId == workspaceId
          && getAfter(invitationPath(request.resource.data.activeInviteHash)).data.createdBy == request.auth.uid
          && getAfter(invitationPath(request.resource.data.activeInviteHash)).data.status == 'pending'
        )
        ||
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.memberUids == [request.auth.uid]
          && request.resource.data.memberUids == resource.data.memberUids
          && resource.data.activeInviteHash is string
          && request.resource.data.activeInviteHash == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeInviteHash', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && getAfter(invitationPath(resource.data.activeInviteHash)).data.status == 'revoked'
        )
        ||
        (
          resource.data.memberUids.size() == 1
          && resource.data.memberUids[0] == resource.data.ownerUid
          && resource.data.activeInviteHash is string
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids[0] == resource.data.ownerUid
          && request.resource.data.memberUids[1] == request.auth.uid
          && request.resource.data.activeInviteHash == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'activeInviteHash', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && getAfter(invitationPath(resource.data.activeInviteHash)).data.status == 'accepted'
          && getAfter(invitationPath(resource.data.activeInviteHash)).data.acceptedBy == request.auth.uid
          && getAfter(memberPath(workspaceId, request.auth.uid)).data.slot == 'B'
          && getAfter(memberPath(workspaceId, request.auth.uid)).data.role == 'member'
          && getAfter(userPath(request.auth.uid)).data.workspaceId == workspaceId
        )
      );

      allow delete: if false;

      match /members/{uid} {
        allow get, list: if isWorkspaceMember(workspaceId);

        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'slot', 'role', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && (
            (
              request.resource.data.slot == 'A'
              && request.resource.data.role == 'owner'
              && getAfter(workspacePath(workspaceId)).data.ownerUid == uid
              && getAfter(workspacePath(workspaceId)).data.memberUids == [uid]
            )
            ||
            (
              request.resource.data.slot == 'B'
              && request.resource.data.role == 'member'
              && get(workspacePath(workspaceId)).data.memberUids.size() == 1
              && get(workspacePath(workspaceId)).data.activeInviteHash is string
              && getAfter(workspacePath(workspaceId)).data.memberUids.size() == 2
              && getAfter(workspacePath(workspaceId)).data.memberUids[1] == uid
              && getAfter(invitationPath(get(workspacePath(workspaceId)).data.activeInviteHash)).data.status == 'accepted'
              && getAfter(invitationPath(get(workspacePath(workspaceId)).data.activeInviteHash)).data.acceptedBy == uid
              && getAfter(userPath(uid)).data.workspaceId == workspaceId
            )
          );

        allow update, delete: if false;
      }

      match /notificationSubscriptions/{subscriptionId} {
        function validNotificationSubscription(data) {
          return data is map
            && data.keys().hasAll(['uid', 'endpoint', 'keys', 'timezone', 'preferences', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['uid', 'endpoint', 'keys', 'timezone', 'preferences', 'createdAt', 'updatedAt'])
            && data.uid == request.auth.uid
            && data.endpoint is string
            && data.endpoint.size() <= 3000
            && data.endpoint.matches('^https://.+$')
            && data.keys is map
            && data.keys.keys().hasAll(['p256dh', 'auth'])
            && data.keys.keys().hasOnly(['p256dh', 'auth'])
            && data.keys.p256dh is string
            && data.keys.p256dh.size() <= 256
            && data.keys.auth is string
            && data.keys.auth.size() <= 128
            && data.timezone is string
            && data.timezone.size() > 0
            && data.timezone.size() <= 128
            && data.preferences is map
            && data.preferences.keys().hasAll(['eventReminders', 'todoDeadlines', 'sharedUpdates'])
            && data.preferences.keys().hasOnly(['eventReminders', 'todoDeadlines', 'sharedUpdates'])
            && data.preferences.eventReminders is bool
            && data.preferences.todoDeadlines is bool
            && data.preferences.sharedUpdates is bool;
        }

        allow get, list: if isWorkspaceMember(workspaceId) && resource.data.uid == request.auth.uid;

        allow create: if isWorkspaceMember(workspaceId)
          && validNotificationSubscription(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isWorkspaceMember(workspaceId)
          && resource.data.uid == request.auth.uid
          && validNotificationSubscription(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endpoint', 'keys', 'timezone', 'preferences', 'updatedAt']);

        allow delete: if isWorkspaceMember(workspaceId) && resource.data.uid == request.auth.uid;
      }

      match /presence/{installId} {
        function validPresence(data) {
          return data is map
            && data.keys().hasAll(['uid', 'installId', 'online', 'lastSeenAt'])
            && data.keys().hasOnly(['uid', 'installId', 'online', 'lastSeenAt'])
            && data.uid == request.auth.uid
            && data.installId == installId
            && data.online is bool
            && data.lastSeenAt == request.time;
        }

        allow get, list: if isWorkspaceMember(workspaceId);

        allow create: if isWorkspaceMember(workspaceId)
          && validPresence(request.resource.data);

        allow update: if isWorkspaceMember(workspaceId)
          && resource.data.uid == request.auth.uid
          && validPresence(request.resource.data);

        allow delete: if isWorkspaceMember(workspaceId)
          && resource.data.uid == request.auth.uid;
      }

      match /{dataCollection}/{recordId} {
        allow get: if isWorkspaceMember(workspaceId)
          && dataCollection in ['todos', 'todoCategories', 'calendarEvents', 'syncConflicts', 'syncDevices', 'todoPurgeMarkers'];
        allow list: if isWorkspaceMember(workspaceId)
          && dataCollection in ['todos', 'todoCategories', 'calendarEvents', 'syncConflicts', 'todoPurgeMarkers'];

        allow create: if isWorkspaceMember(workspaceId) && (
          (dataCollection in ['todos', 'todoCategories', 'calendarEvents']
            && validWorkspaceRecordCreate(request.resource.data, dataCollection, recordId))
          || (dataCollection == 'todos'
            && exists(todoPurgeMarkerPath(workspaceId, recordId))
            && validWorkspaceTodoRestore(request.resource.data, workspaceId, recordId))
          || (dataCollection == 'todoPurgeMarkers'
            && validTodoPurgeMarkerCreate(request.resource.data, workspaceId, recordId))
          || (dataCollection == 'syncConflicts'
            && validConflictCreate(request.resource.data))
          || (dataCollection == 'syncDevices'
            && validSyncDeviceCreate(recordId, request.resource.data))
        );

        allow update: if isWorkspaceMember(workspaceId) && (
          (dataCollection in ['todos', 'todoCategories', 'calendarEvents']
            && validWorkspaceRecordUpdate(request.resource.data, dataCollection, recordId))
          || (dataCollection == 'todoPurgeMarkers'
            && validTodoPurgeMarkerUpdate(request.resource.data, workspaceId, recordId))
          || (dataCollection == 'syncConflicts'
            && (validConflictUpdate(request.resource.data) || validConflictLocalRefresh(request.resource.data) || validConflictResolution(request.resource.data)))
          || (dataCollection == 'syncDevices'
            && validSyncDeviceUpdate(recordId, request.resource.data))
        );

        allow delete: if dataCollection == 'todos' && validTodoPurgeDelete(workspaceId, recordId);
      }
    }

    match /invitations/{inviteHash} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && inviteHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['workspaceId', 'createdBy', 'status', 'createdAt', 'expiresAt', 'acceptedBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.acceptedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
        && get(workspacePath(request.resource.data.workspaceId)).data.ownerUid == request.auth.uid
        && get(workspacePath(request.resource.data.workspaceId)).data.memberUids == [request.auth.uid]
        && getAfter(workspacePath(request.resource.data.workspaceId)).data.activeInviteHash == inviteHash;

      allow update: if signedIn() && (
        (
          resource.data.status == 'pending'
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedAt == request.time
          && get(workspacePath(resource.data.workspaceId)).data.activeInviteHash == inviteHash
          && getAfter(workspacePath(resource.data.workspaceId)).data.ownerUid == request.auth.uid
          && getAfter(workspacePath(resource.data.workspaceId)).data.activeInviteHash != inviteHash
        )
        ||
        (
          resource.data.status == 'pending'
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && get(workspacePath(resource.data.workspaceId)).data.activeInviteHash == inviteHash
          && getAfter(workspacePath(resource.data.workspaceId)).data.activeInviteHash == null
          && getAfter(workspacePath(resource.data.workspaceId)).data.memberUids.size() == 2
          && getAfter(memberPath(resource.data.workspaceId, request.auth.uid)).data.slot == 'B'
          && getAfter(userPath(request.auth.uid)).data.workspaceId == resource.data.workspaceId
        )
      );

      allow delete: if false;
    }
  }
}
